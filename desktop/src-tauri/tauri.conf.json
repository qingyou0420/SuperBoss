{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperBoss",
  "version": "0.2.0",
  "identifier": "studio.grisia.superboss",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperBoss",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzRjk0RjA0NUZEODdGRjgKUldUNGY5aGZCRS81bzBaUjkwL3ZoUjZ2ZTZwWE83TlkwamZjcWo1cFoyTVMxbjBoVU42ZUFOVnkK",
      "endpoints": [
        "https://github.com/qingyou0420/SuperBoss/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
