# Public hostnames. The example domains contain no private address information.
SUPERBOSS_ENVIRONMENT=production
SUPERBOSS_APP_HOST=nightforest.com
SUPERBOSS_OBJECTS_HOST=objects.nightforest.com

# Supply host paths only in the private .env file used for deployment.
SUPERBOSS_TLS_CERT_PATH=
SUPERBOSS_TLS_KEY_PATH=
SUPERBOSS_ALLOWLIST_PATH=

# Use URL-safe random password material; values stay blank in this template.
SUPERBOSS_POSTGRES_DB=superboss
SUPERBOSS_POSTGRES_USER=superboss
SUPERBOSS_POSTGRES_PASSWORD=
SUPERBOSS_REDIS_PASSWORD=
SUPERBOSS_JWT_SECRET=

SUPERBOSS_WECOM_CORP_ID=
SUPERBOSS_WECOM_AGENT_ID=
SUPERBOSS_WECOM_CORP_SECRET=
SUPERBOSS_WECOM_REDIRECT_URI=
SUPERBOSS_OWNER_WECOM_USERID=

SUPERBOSS_S3_BUCKET=superboss-files
SUPERBOSS_S3_ACCESS_KEY_ID=
SUPERBOSS_S3_SECRET_ACCESS_KEY=

SUPERBOSS_CLAMAV_HOST=clamav
SUPERBOSS_CLAMAV_PORT=3310
SUPERBOSS_CLAMAV_CONNECT_TIMEOUT_SECONDS=3
SUPERBOSS_CLAMAV_IO_TIMEOUT_SECONDS=10
SUPERBOSS_CLAMAV_TOTAL_TIMEOUT_SECONDS=600
SUPERBOSS_CLAMAV_MAX_CHUNK_BYTES=1048576
SUPERBOSS_CLAMAV_MAX_STREAM_BYTES=104857600
SUPERBOSS_CLAMAV_MAX_RESPONSE_BYTES=1024
SUPERBOSS_SCAN_SOFT_TIME_LIMIT_SECONDS=660
SUPERBOSS_SCAN_HARD_TIME_LIMIT_SECONDS=720

SUPERBOSS_RELEASE_TAG=local
