# Public hostnames. The example domains contain no private address information.
SUPERBOSS_ENVIRONMENT=production
SUPERBOSS_APP_HOST=app.example.invalid
SUPERBOSS_OBJECTS_HOST=objects.example.invalid

# Supply host paths only in the private .env file used for deployment.
SUPERBOSS_TLS_CERT_PATH=
SUPERBOSS_TLS_KEY_PATH=
SUPERBOSS_ALLOWLIST_PATH=

# Use URL-safe random password material; values stay blank in this template.
SUPERBOSS_POSTGRES_DB=superboss
SUPERBOSS_POSTGRES_USER=superboss
SUPERBOSS_POSTGRES_PASSWORD=
SUPERBOSS_REDIS_PASSWORD=
SUPERBOSS_JWT_SECRET=

SUPERBOSS_S3_BUCKET=superboss-files
SUPERBOSS_S3_ACCESS_KEY_ID=
SUPERBOSS_S3_SECRET_ACCESS_KEY=

SUPERBOSS_RELEASE_TAG=local
