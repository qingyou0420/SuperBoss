{
  "schema_version": 1,
  "levels": {
    "L0": {
      "budgets": {"files": 5, "production_lines": 0, "test_lines": 0, "documentation_lines": 300},
      "verification": ["governance"]
    },
    "L1": {
      "budgets": {"files": 8, "production_lines": 250, "test_lines": 500, "documentation_lines": 0},
      "verification": ["focused", "static"],
      "timeout_seconds": 300
    },
    "L2": {
      "budgets": {"files": 20, "production_lines": 700, "test_lines": 1000, "documentation_lines": 300},
      "verification": ["focused", "affected"],
      "timeout_seconds": 900
    },
    "L3": {
      "requires_approval": true,
      "verification": ["specialized"],
      "timeout_seconds": 1800,
      "triggers": ["auth_source", "authorization", "database", "migration", "dependency", "container", "service", "route", "network_boundary", "persistent_state", "deployment_boundary", "external_io_exactly_once"]
    }
  },
  "path_classification": {
    "tests": ["server/tests/**", "integrations/**/tests/**", "web/**/*.test.*", "web/**/*.spec.*"],
    "documentation": ["docs/**", "README.md", "**/*.md"],
    "unknown": "production"
  },
  "gates": {
    "governance": {"cwd": "server", "steps": ["uv", "run", "pytest", "-q", "tests/unit/governance"], "timeout_seconds": 300, "kind": "governance"},
    "governance-static": {"cwd": "server", "steps": ["uv", "run", "ruff", "check", "../scripts/governance_check.py", "../scripts/verify_changed.py", "tests/unit/governance"], "timeout_seconds": 300, "kind": "governance"},
    "backend": {"cwd": "server", "steps": ["uv", "run", "pytest", "-q", "tests/unit"], "timeout_seconds": 900, "kind": "backend"},
    "backend-full": {"cwd": "server", "steps": ["uv", "run", "pytest", "-q"], "timeout_seconds": 900, "kind": "backend"},
    "web-focused": {"cwd": "web", "steps": ["npm", "run", "test", "--", "related", "--run"], "timeout_seconds": 900, "kind": "web"},
    "web-lint": {"cwd": "web", "steps": ["npm", "run", "lint"], "timeout_seconds": 900, "kind": "web"},
    "web-static": {"cwd": "web", "steps": ["npm", "run", "typecheck"], "timeout_seconds": 900, "kind": "web"},
    "web-full": {"cwd": "web", "steps": ["npm", "run", "test", "--", "--run"], "timeout_seconds": 900, "kind": "web"},
    "connector": {"cwd": "integrations/kimi-superboss/connector", "steps": ["uv", "run", "pytest", "-q"], "timeout_seconds": 900, "kind": "connector"},
    "connector-full": {"cwd": "integrations/kimi-superboss/connector", "steps": ["uv", "run", "pytest", "-q"], "timeout_seconds": 900, "kind": "connector"},
    "e2e-contract": {"cwd": "server", "steps": ["uv", "run", "pytest", "-q", "tests/unit/test_deployment_contract.py"], "timeout_seconds": 1800, "kind": "e2e-contract"},
    "compose": {"cwd": ".", "steps": ["docker", "compose", "config"], "timeout_seconds": 1800, "kind": "compose"},
    "windows-packaging": {"cwd": "integrations/kimi-superboss", "steps": ["powershell", "-File", "scripts/build-windows.ps1"], "timeout_seconds": 1800, "kind": "windows-packaging"}
  },
  "limits": {"single_file_lines": 800, "test_to_production_ratio": 2, "max_review_round": 2, "max_active_tasks": 1},
  "forbidden_artifacts": ["**/*.diff", "**/*.patch", ".superpowers/**/reports/**"],
  "approval": {"local_status": "WAITING_FOR_OWNER_VERIFICATION", "platform_owner_enforced_only": true}
}
